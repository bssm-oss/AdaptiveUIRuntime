{
  "name": "@adaptive-ui/core",
  "description": "Deterministic adaptive UI planning engine for constrained personalization.",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bssm-oss/AdaptiveUIRuntime.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bssm-oss/AdaptiveUIRuntime#readme",
  "bugs": {
    "url": "https://github.com/bssm-oss/AdaptiveUIRuntime/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
