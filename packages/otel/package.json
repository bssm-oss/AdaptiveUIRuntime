{
  "name": "@adaptive-ui/otel",
  "description": "OpenTelemetry bridge for adaptive UI runtime telemetry.",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bssm-oss/AdaptiveUIRuntime.git",
    "directory": "packages/otel"
  },
  "homepage": "https://github.com/bssm-oss/AdaptiveUIRuntime#readme",
  "bugs": {
    "url": "https://github.com/bssm-oss/AdaptiveUIRuntime/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "keywords": [
    "adaptive-ui",
    "opentelemetry",
    "telemetry",
    "personalization"
  ],
  "dependencies": {
    "@adaptive-ui/core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.201.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.201.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-web": "^2.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
