{
  "name": "adaptive-ui-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "bootstrap": "./run install",
    "dev": "./run dev",
    "check": "./run check",
    "verify": "./run all",
    "usage": "./run usage",
    "e2e": "./run e2e",
    "lint": "pnpm exec eslint . && pnpm exec prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm exec vitest run",
    "build": "pnpm -r run build",
    "test:e2e": "pnpm --filter ./examples/saas-dashboard test:e2e",
    "test:usage": "pnpm build && pnpm --filter @adaptive-ui/usage-smoke smoke",
    "bench": "pnpm exec vitest bench packages/core/src/__benchmarks__/resolvePlan.bench.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.3.2",
    "vitest": "^3.1.1"
  }
}
