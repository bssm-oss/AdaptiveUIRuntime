{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@adaptive-ui/core": ["packages/core/src/index.ts"],
      "@adaptive-ui/react": ["packages/react/src/index.ts"],
      "@adaptive-ui/devtools": ["packages/devtools/src/index.ts"],
      "@adaptive-ui/otel": ["packages/otel/src/index.ts"],
      "@adaptive-ui/llm": ["packages/llm/src/index.ts"],
      "@adaptive-ui/llm/openai": ["packages/llm/src/openai.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "types": ["node"]
  }
}
